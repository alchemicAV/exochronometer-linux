# Build outputs - all regenerated by scripts/make-package.sh
node_modules/
build/
dist/
packaging/*.tar.gz
packaging/exochronometer-*.pkg.tar.zst
packaging/omarchy/*.pkg.tar.zst
packaging/LICENSE

# Swift oracle packages. The GENERATORS are kept (they are how the reference
# vectors were produced and how they would be reproduced); their build products are
# not - .build alone is ~250 MB of compiled Swift and intermediate objects.
reference/**/.build/
reference/**/.swiftpm/
reference/**/*.o

# Nested repositories under reference/ are snapshots of other projects that were
# cloned in for porting. Keep their FILES, drop their history rather than recording
# an unresolvable gitlink.
reference/**/.git/

# Python / editor / runtime noise
.venv/
__pycache__/
*.pyc
*.log
*.swp
.DS_Store