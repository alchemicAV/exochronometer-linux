<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    App group removed: nothing reads or writes it (no suiteName, no
    container URL), and free provisioning can't grant it — an unsatisfiable
    entitlement stops the widget extension from launching when re-signed
    for sideloading, so WidgetKit never lists it in the gallery.
    Restore alongside the app's copy if a shared container is ever needed
    on a paid account.

    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.alchemicav.exochronometer</string>
    </array>
    -->
</dict>
</plist>
